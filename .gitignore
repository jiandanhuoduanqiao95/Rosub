# ============================================================
# 聊天室项目 —— .gitignore
# 防止误提交密钥/证书、数据库、构建产物与运行时数据
# （AGENTS.md 提交规范：不提交密钥、证书、数据库文件、构建产物）
# ============================================================

# 证书与私钥（SSL/ 下的生成脚本 SSL.py / gen_cert.py 仍被跟踪，勿忽略整个目录）
SSL/*.crt
SSL/*.key
SSL/*.pem

# 数据库文件（含运行时生成的备份）
users.db
*.db

# Python 缓存
__pycache__/
*.pyc

# 运行时文件存储（待处理/历史文件、收到的文件）
file_store/
files/
received_files/

# 构建产物与 IDE 配置
.dart_tool/
.idea/
.zcode/

# 杂项临时文件
project_files.txt
